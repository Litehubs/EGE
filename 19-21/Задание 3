def f(a,b,m):
    if 105 <= (a + b) <= 170: return m % 2 == 0
    if m == 0: return 0
    h = [f(a +10,b, m-1),f(a *2,b,m -1),
         f(a,b + 10, m -1), f(a,b * 2,m -1)]
    return any(h) if (m - 1) % 2 ==0 else all(h)
print([s for s in range(1,101) if f(5,s,4) and not f(5,s,2)])
