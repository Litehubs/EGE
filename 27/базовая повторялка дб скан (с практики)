from turtle import *
from math import *
def visual(clusters):
    k = 25
    colors = ['red','green','blue','pink']
    screensize(3000,3000),penup(), tracer(0)
    for i in range(len(clusters)):
        for x,y in clusters[i]:
            setpos(x*k,y*k)
            dot(20,colors[i])
    done()

f = open('27_5.txt')
f.readline()
points = [list(map(float, s.replace(',','.').split())) for s in f]
clusters, eps = [], 0.9
while points:
    clusters.append([points[0]])
    del points[0]
    for p1 in clusters[-1]:
        for p2 in points[:]:
            if dist(p1,p2) < eps:
                clusters[-1].append(p2)
                points.remove(p2)
    if len(clusters[-1]) <= 30:
        del clusters[-1]
print(len(clusters))
# visual(clusters)
best_centroids = [[] for _ in range(len(clusters))]
for i in range(len(clusters)):
    min_sum_dist = 10**10
    for c1 in clusters[i]:
        sum_dist = 0
        for p1 in clusters[i]:
            sum_dist += dist(c1,p1)
        if sum_dist < min_sum_dist:
            min_sum_dist = sum_dist
            best_centroids[i] = c1
print(best_centroids)
Px = sum([x for x,y in best_centroids])
Py = sum([y for x,y in best_centroids])
print(abs((Px*10000)//1),abs((Py*10000)//1))
