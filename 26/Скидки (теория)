f = open('26.1.txt')
n = int(f.readline())
a = [int(s) for s in f]
a120 = [x for x in a if x > 120]                #на товары, которые стоят дороже 120, распространяется скидка
a120.sort()                            #сортируем по возрастанию
sale = sum(a120[:len(a120)//2]) * 0.25        #считаем скидку
print(len(a120),len(a120[:len(a120)//2]))             #вывод для проверки данных (необязательный шаг)
print(sum(a) - sale, max(a120[:len(a120)//2]))   #Выводим общая сумма -  скидка ; максимальная стоимость товаров со скидкой

