9)нечетная цифра
from itertools import *
cnt = 0
for i in product('0123456', repeat = 5):
    chislo = ''.join(i)
    if chislo[0] != '0' and chislo.count('2') ==2:
        for d in '135':
            chislo = chislo.replace(d, '*')
        if '*2' not in chislo and '2*' not in chislo:
            cnt+=1
print(cnt)

