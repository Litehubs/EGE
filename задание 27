from math import *
f = open('27_A_1.txt')
f.readline()
k = 2
points = [list(map(float, s.replace(',','.').split())) for s in f]            #Список точек
clusters = [ [] for _ in range(k)]         #добавляем пустые списки
for x, y in points:                        #проходимся по всем точкам
    if y > 10:
        clusters[0].append([x,y])
    else:
        clusters[1].append([x,y])
best_centroids = [ [] for _ in range(k)]             #создаем переменную
for i in range(k):
    min_sum_dist = 10**10
    for c1 in clusters[i]:                       #перебираем все возможные центроиды
        sum_dist = 0
        for p1 in clusters[i]:
            sum_dist += dist(c1,p1)
        if sum_dist < min_sum_dist:
            min_sum_dist = sum_dist
            best_centroids[i] = c1                 #от этой точки (c1) суммарное расстояние всех остальных минимально
print(best_centroids)                              #выводим для проверки точек на центроиды в либре/икселе
P_x = sum([x for x,y in best_centroids]) / k
P_y = sum([y for x,y in best_centroids]) / k
print(int(P_x * 10000),int(P_y * 10000))         #выводим целую часть и умножаем на 10000 по условии задачи

